# =============================================================================
# .env.example — SOURCE OF TRUTH FOR THE STACK
# Copy this to .env and set BASE_DOMAIN before running setup.sh
# =============================================================================

# ── Domain Configuration ─────────────────────────────────────────────────────
# dev: local.dev | prod: yourdomain.com | staging: staging.yourdomain.com
BASE_DOMAIN=local.dev

# ── Derived Hosts (Calculated by setup.sh, but can be overridden) ──────────
AUTH_HOST=auth.local.dev
APP_HOST=app.local.dev
API_HOST=api.local.dev
TRAEFIK_HOST=traefik.local.dev

# ── TLS Configuration ────────────────────────────────────────────────────────
# dev: uses default cert (mkcert wildcard *.localhost)
# prod: change certs in traefik/config/tls.yml or add certresolver via docker-compose override
# TLS_RESOLVER is no longer used in dev mode — certresolver labels were removed
# to prevent invalid empty values from breaking routers
# TLS_RESOLVER=

# ── Let's Encrypt (Production Only) ──────────────────────────────────────────
LETSENCRYPT_EMAIL=admin@local.dev

# ── Keycloak Database ────────────────────────────────────────────────────────
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=

# ── Application Database ─────────────────────────────────────────────────────
DB_NAME=saas
DB_USER=saas
DB_PASSWORD=
DB_HOST=app-db
DB_PORT=5432

# ── Keycloak Admin ───────────────────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=

# ── OAuth2-Proxy ─────────────────────────────────────────────────────────────
OAUTH2_PROXY_CLIENT_ID=oauth2-proxy
OAUTH2_PROXY_CLIENT_SECRET=
SAAS_API_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=

# ── Traefik ──────────────────────────────────────────────────────────────────
# Default: admin:changeme (htpasswd -nB admin)
TRAEFIK_DASHBOARD_PASSWORD_HASH=$$2y$$05$$Vv9Ct7OiPqanfr0J5T3fEO3.0JpIK3kEOkjXAG9VECMuHGNDrUSDC

# ── Security ─────────────────────────────────────────────────────────────────
# dev: true (skip cert verification) | prod: false
OAUTH2_PROXY_SSL_INSECURE=true
