# =============================================================================
# oauth2-proxy.cfg.tmpl — OAuth2-Proxy Template
# Variables: ${AUTH_HOST} ${APP_HOST} ${BASE_DOMAIN}
#            ${OAUTH2_PROXY_CLIENT_ID} ${OAUTH2_PROXY_CLIENT_SECRET} ${OAUTH2_PROXY_COOKIE_SECRET}
# =============================================================================

provider = "keycloak-oidc"
provider_display_name = "SSO"
oidc_issuer_url = "https://${AUTH_HOST}/realms/saas"
client_id = "${OAUTH2_PROXY_CLIENT_ID}"
scope = "openid email profile roles"
oidc_groups_claim = "groups"
oidc_email_claim = "email"

redirect_url = "https://${APP_HOST}/oauth2/callback"
http_address = "0.0.0.0:4180"

cookie_name     = "_oauth2_proxy"
cookie_secure   = true
cookie_httponly = true
cookie_samesite = "none"
cookie_expire   = "24h"
cookie_refresh  = "1h"

cookie_csrf_per_request = true
cookie_csrf_expire      = "15m"

# cookie_domains removido intencionalmente:
# Domain=.localhost é rejeitado por alguns browsers com SameSite=None
# Sem domain explícito, o cookie usa o host exato (app.localhost)

upstreams = ["http://frontend:80"]

email_domains = ["*"]
allowed_roles = ["user"]
allowed_groups = ["/app-users"]

set_xauthrequest = true
pass_access_token = true
pass_authorization_header = true
set_authorization_header = true

skip_provider_button = true
code_challenge_method = "S256"

skip_auth_routes = [
  "^/healthz$",
  "^/metrics$",
  "^/api/public/.*"
]

oidc_audience_claims = "aud"
skip_jwt_bearer_tokens = true

# Environment variable OAUTH2_PROXY_SSL_INSECURE
ssl_insecure_skip_verify = ${OAUTH2_PROXY_SSL_INSECURE}

# Trust X-Forwarded-* headers from Traefik (needed for correct HTTPS redirect URLs)
reverse_proxy = true

# Logging
standard_logging = true
auth_logging     = true
